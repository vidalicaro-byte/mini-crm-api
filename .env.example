# Copy to .env for local overrides. Never commit .env.
ENVIRONMENT=development

# SQLite file in the project folder (default). For PostgreSQL use, for example:
# DATABASE_URL=postgresql://user:password@localhost:5432/crm
DATABASE_URL=sqlite:///./crm.db

# Signs the access tokens. Required in production (ENVIRONMENT=production): at least 32 random
# characters. Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
